# Python
__pycache__/
*.py[cod]

# Virtual environments (uv creates .venv/.gitignore, this is belt and braces)
.venv/

# Data stuff
pi_data/

# Generated payload — large (~370 MiB: .npz tensor + 55 CSVs).
# NOTE: the figures under data/artifacts/figures/ are deliberately NOT ignored:
# they are small and are embedded in README.md.
data/artifacts/dataset/
/.metadata/

# Local planning notes — working scratch, not part of the deliverable
/milestones-draft.md

# Build outputs of RT-MOMS/tests. The .exe rule covers host builds; the bare
# names would be produced by a target or Linux build with the same Makefile, and
# .arm by the cross-compile step in REPRODUCE.md section 7.
/RT-MOMS/tests/*.exe
/RT-MOMS/tests/*.arm
/RT-MOMS/tests/test_sensor
/RT-MOMS/tests/test_protocol
/RT-MOMS/tests/test_block_loader
/RT-MOMS/tests/test_mergesort
/RT-MOMS/tests/test_median
/RT-MOMS/tests/test_shared_memory
/RT-MOMS/tests/sensor_demo
/RT-MOMS/tests/loader_demo
/RT-MOMS/tests/pipeline_demo
# Compiler probe the tests Makefile writes to pick a thread-capable compiler
/RT-MOMS/tests/.threadprobe.c

# BSP build outputs: a `make` in RT-MOMS/ populates install/, leaves objects
# beside the sources, can emit symbol files, and overwrites the committed image.
/RT-MOMS/install/
/RT-MOMS/images/*.sym
# Object directories: a make leaves generated dependency files, usage info,
# maps and the linked drivers under src/**/aarch64/<variant>/, beside the
# tracked Makefiles that produce them. Nothing there is source.
/RT-MOMS/src/**/aarch64/**

# Binaries the app Makefile builds in place for the target
/RT-MOMS/app/test_protocol
/RT-MOMS/app/test_sensor
/RT-MOMS/app/test_block_loader
/RT-MOMS/app/test_mergesort
/RT-MOMS/app/test_median
/RT-MOMS/app/test_shared_memory
/RT-MOMS/app/sensor_demo
/RT-MOMS/app/loader_demo
/RT-MOMS/app/pipeline_demo
/RT-MOMS/app/sortmed-server
/RT-MOMS/app/sortmed-client
/RT-MOMS/app/*.o

# Figures produced from a board run by tools/plot_run.py — regenerable from the
# run's output files, so they are not part of the deliverable.
/run-figures/

# A board run's own output files, copied into tools/ for plotting
/tools/*.bin
/tools/medians.csv
/tools/*.png
